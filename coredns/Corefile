# ══════════════════════════════════════════════
# NetWatch AI — CoreDNS Configuration
# DNS firewall with blocklist support
# ══════════════════════════════════════════════

. {
    # Bind to all interfaces
    bind 0.0.0.0

    # ── DNS Query Logging ─────────────────────
    log . "{remote} {type} {name} {rcode}" {
        class denial error success
    }

    # ── Blocklists (Dynamic Categories) ───────
    # Generated by backend's blocklist updater
    import /etc/coredns/blocklists/active_blocklists.conf

    # ── Per-device rules ──────────────────────
    # Generated by backend per-device rule engine
    # import /etc/coredns/per-device/*.conf

    # ── Upstream DNS Forwarding ───────────────
    forward . 1.1.1.1 8.8.8.8 {
        prefer_udp
        max_concurrent 1000
    }

    # ── Response Caching ──────────────────────
    cache 300 {
        success 9984 300
        denial 9984 60
    }

    # ── Health Check ──────────────────────────
    health :8082

    # ── Error Logging ─────────────────────────
    errors

    # ── Reload Plugin ─────────────────────────
    reload 5s
}
