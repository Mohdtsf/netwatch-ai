# ══════════════════════════════════════════════
# NetWatch AI — Environment Configuration
# Copy to .env and edit values before starting
# ══════════════════════════════════════════════

# ── Deployment Profile ────────────────────────
# minimal  = 512 MB RAM, no ML, old laptops/Pi 3
# standard = 600 MB RAM, full features (default)
# full     = 1.2 GB RAM, MLflow tracking, dedicated machines
NETWATCH_PROFILE=standard

# ── Network Interface ─────────────────────────
# Interface to capture packets from (run: ip link show)
CAPTURE_INTERFACE=eth0

# Subnet to scan for devices (CIDR notation)
SCAN_SUBNET=192.168.1.0/24

# ── Security ──────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
ADMIN_EMAIL=admin@localhost

# ── Database ──────────────────────────────────
SQLITE_DB_PATH=/app/data/netwatch.db
SQLITE_CACHE_SIZE_MB=64

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_MEMORY=50mb

# ── NATS ──────────────────────────────────────
NATS_URL=nats://nats:4222

# ── CoreDNS ───────────────────────────────────
COREDNS_UPSTREAM_1=1.1.1.1
COREDNS_UPSTREAM_2=8.8.8.8
BLOCKLIST_UPDATE_INTERVAL_HOURS=24

# ── WireGuard VPN ─────────────────────────────
WG_SERVER_PORT=51820
WG_SERVER_ADDRESS=10.8.0.1/24
WG_ENDPOINT=auto  # auto-detects public IP, or set manually
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VPN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_32_BYTE_BASE64_KEY_WITH_FERNET

# ── ML Engine ─────────────────────────────────
ML_ANOMALY_THRESHOLD=-0.2
ML_RETRAIN_INTERVAL_HOURS=24
THREAT_INTEL_UPDATE_HOURS=6

# ── Data Retention ────────────────────────────
FLOW_RETENTION_DAYS=90
DNS_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=365

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── GeoIP (MaxMind) ──────────────────────────
# Sign up at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=
